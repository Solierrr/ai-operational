# Chaves de API para os Modelos de Linguagem
GEMINI_API_KEY=sua_chave_do_gemini_aqui
GROQ_API_KEY=sua_chave_do_groq_aqui
OPENAI_API_KEY=sua_chave_da_openai_aqui
LLM_MODEL_OPENAI=gpt-6-luna
LLM_PROVIDER_ORDER=gemini,groq,openai

# Conexão com o Banco de Dados MongoDB (checkpointer de curto prazo do LangGraph)
MONGODB_URI=mongodb://localhost:27017

# api-messenger: conversas e mensagens passam a viver lá, não mais no Mongo local
API_MESSENGER_URL=http://localhost:8080

# /service-keys
SERVICE_KEY=

# Redis dos agentes no Upstash
UPSTASH_REDIS_HOST=seu-banco-123456.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_USERNAME=default
UPSTASH_REDIS_PASSWORD=sua_senha_aqui

# Não declare essa variável de ambiente para testar LOCAL, o default no settings.py é LOCAL.
# Essa variavel muda nas envs de QA e PROD.
ENVIRONMENT=LOCAL

# Swagger (/docs) e contrato (/openapi.json); false em PROD.
DOCS_ENABLED=true

DEBUG_ADMIN_SUBS=


# Validação do JWT de usuário (RS256/JWKS, emitido pelo api-auth).
# Local: api-auth do `make dev-up` do database-console.
JWT_JWKS_URL=http://localhost:8081/.well-known/jwks.json
JWT_ISSUER=solaria-auth

# mcp-database: recebe o X-Service-Key (SERVICE_KEY). A chave antiga vai junto
# só enquanto o mcp-database ainda aceita o x-api-key; deixe vazia quando ele
# exigir a chave de serviço.
MCP_URL=http://localhost:8001/mcp
MCP_API_KEY=

# api-core (ações aprovadas pelo usuário são executadas aqui, com o JWT dele)
API_CORE_URL=http://localhost:8080/api

# A2A: URL pública deste serviço (Agent Card)
A2A_PUBLIC_URL=http://localhost:8003
